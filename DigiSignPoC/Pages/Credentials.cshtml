@page
@model CredentialsModel
@{
    ViewData["Title"] = "Shared DigiSign credentials";
}

<h1>Shared DigiSign credentials</h1>
<p class="lead">
    Configure authentication once for both the Identify and document-signing workflows.
</p>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.WarningMessage is not null)
{
    <div class="alert alert-warning">
        <strong>@Model.WarningMessage</strong>
        @if (Model.AuthenticationValidation.Message is not null)
        {
            <div>@Model.AuthenticationValidation.Message</div>
        }
    </div>
}

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<div class="alert @(Model.AuthenticationValidation.IsValid ? "alert-success" : "alert-warning")">
    <strong>
        @(Model.AuthenticationValidation.IsValid
            ? "Authentication configured and validated"
            : Model.AuthenticationValidation.RequiresReauthentication
                ? "Authentication needs to be updated"
                : "Authentication configured; validation is temporarily unavailable")
    </strong>
    <div>Environment: <code>@Model.Authentication.BaseUrl</code></div>
    <div>
        Cached token:
        @(Model.Authentication.HasBearerToken ? "yes" : "no")
        @if (Model.Authentication.TokenExpiresAt is not null)
        {
            <span>— expires @Model.Authentication.TokenExpiresAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")</span>
        }
    </div>
    <div>API keys available in this application session: @(Model.Authentication.HasApiKeys ? "yes" : "no")</div>
</div>

<form method="post">
    <div class="card mb-4">
        <div class="card-header"><strong>DigiSign environment</strong></div>
        <div class="card-body">
            <label asp-for="Input.BaseUrl" class="form-label">API base URL</label>
            <input asp-for="Input.BaseUrl" class="form-control" />
            <div class="btn-group btn-group-sm mt-2" role="group" aria-label="Environment presets">
                <button type="button" class="btn btn-outline-secondary environment-preset"
                        data-url="https://api.staging.digisign.org">Staging</button>
                <button type="button" class="btn btn-outline-secondary environment-preset"
                        data-url="https://api.digisign.org">Production</button>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header"><strong>Authentication</strong></div>
        <div class="card-body">
            <p>Enter an existing bearer token, or enter both API keys to obtain and automatically refresh a token.</p>
            <p class="form-text">When both API keys are entered, they take priority over the displayed bearer token and obtain a new token.</p>

            <label asp-for="Input.BearerToken" class="form-label">Saved or existing bearer token</label>
            <textarea asp-for="Input.BearerToken" rows="7"
                      class="form-control font-monospace text-break mb-1"
                      autocomplete="off" spellcheck="false"></textarea>
            <p class="form-text mb-3">
                The complete saved bearer token is loaded after every application start.
                Length: <strong id="bearer-token-length">@(Model.Input.BearerToken?.Length ?? 0)</strong> characters.
            </p>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.AccessKey" class="form-label">accessKey</label>
                    <input asp-for="Input.AccessKey" class="form-control" autocomplete="off" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.SecretKey" class="form-label">secretKey</label>
                    <input asp-for="Input.SecretKey" type="password" class="form-control" autocomplete="new-password" />
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save and validate credentials</button>
    <a asp-page="/Index" class="btn btn-outline-secondary">Back to workflows</a>
</form>

<div class="alert alert-info mt-4">
    Only the bearer token, DigiSign environment, and token timestamps are saved locally in
    <code>App_Data/digisign-auth.json</code> for this PoC. The access key and secret key remain
    in application memory only and are not saved.
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.environment-preset').forEach(button => {
            button.addEventListener('click', () => {
                document.getElementById('Input_BaseUrl').value = button.dataset.url;
            });
        });

        const bearerTokenInput = document.getElementById('Input_BearerToken');
        const bearerTokenLength = document.getElementById('bearer-token-length');
        bearerTokenInput.addEventListener('input', () => {
            bearerTokenLength.textContent = bearerTokenInput.value.trim().length;
        });
    </script>
}
