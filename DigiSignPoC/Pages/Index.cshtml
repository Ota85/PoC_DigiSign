@page
@model IndexModel
@{
    ViewData["Title"] = "DigiSign PoC";
}

<div class="py-4">
    <h1>DigiSign integration PoC</h1>
    <p class="lead">Choose an independent provider workflow. Both use the same server-side DigiSign credentials.</p>

    <div class="alert @(Model.Authentication.IsConfigured ? "alert-success" : "alert-warning") d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <strong>@(Model.Authentication.IsConfigured ? "Shared authentication is configured." : "Configure shared authentication before starting.")</strong>
            <div class="small"><code>@Model.Authentication.BaseUrl</code></div>
        </div>
        <a class="btn @(Model.Authentication.IsConfigured ? "btn-outline-success" : "btn-warning")"
           asp-page="/Credentials">Manage credentials</a>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h2 class="h4">Identify a person</h2>
                    <p>
                        Start a standalone DigiSign Identify journey for document scanning, selfie/liveness,
                        and automatic or manual approval.
                    </p>
                    <a class="btn btn-primary mt-auto align-self-start" asp-page="/Identify">Open Identify workflow</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h2 class="h4">Sign a document</h2>
                    <p>
                        Upload a PDF and sign it using Bank iD SIGN or a simple signature protected by a new
                        DigiSign Identify verification.
                    </p>
                    <a class="btn btn-primary mt-auto align-self-start" asp-page="/Signing">Open signing workflow</a>
                </div>
            </div>
        </div>
    </div>
</div>
